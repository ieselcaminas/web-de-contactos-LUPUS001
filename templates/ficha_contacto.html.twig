{% extends 'base.html.twig' %}
{% block body %}
    {% if contacto %}
        <h2>{{ contacto.nombre }}</h2>
        <p><strong>Teléfono:</strong> {{ contacto.telefono }}</p>
        <p><strong>Email:</strong> {{ contacto.email }}</p>

        <a href="{{ path('editar', {'codigo': contacto.id}) }}" class="btn btn-warning">Editar</a>
        <a href="{{ path('eliminar_contacto', {'id': contacto.id}) }}" class="btn btn-danger"
           onclick="return confirm('¿Seguro que quieres eliminar este contacto?');">
           Borrar
        </a>
        <a href="{{ path('inicio') }}" class="btn btn-secondary">Volver</a>
    {% else %}
        <p>El contacto no existe o ha sido eliminado.</p>
    {% endif %}
{% endblock %}

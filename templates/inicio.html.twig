{% extends 'base.html.twig' %}
{% block body %}
	<h1>Lista de contactos</h1>
	
	<a href="{{ path('nuevo') }}">Nuevo contacto</a>

	<ul>
		{% for contacto in contactos %}
			<li>
				<a href= "{{ path('ficha_contacto', {'codigo': contacto.id}) }}"> {{ contacto.nombre }} - {{ contacto.email }} </a>
			</li>
			{% else %}	
				<li>El contacto no se ha encontrado o no existe</li>

		{% endfor %}
	</ul>
{% endblock %}